[Unit]
Description=Forte local GPU inference worker
After=network-online.target
[Service]
User=@SERVICE_USER@
WorkingDirectory=@SERVICE_ROOT@
EnvironmentFile=@SERVICE_ROOT@/secrets/service.env
Environment=HF_HUB_OFFLINE=1
Environment=HF_HOME=@HF_HOME@
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONUNBUFFERED=1
ExecStart=@SERVICE_ROOT@/.venv/bin/python -m backend.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
UMask=0077
[Install]
WantedBy=multi-user.target
