@PUBLIC_HOST@ {
    log {
        output file @SERVICE_ROOT@/data/logs/http-access.json {
            roll_size 10MiB
            roll_keep 3
            roll_keep_for 24h
        }
        format filter {
            request>headers delete
            resp_headers delete
            request>remote_ip delete
            request>remote_port delete
            request>client_ip delete
        }
    }
    request_body {
        max_size 11GB
    }
    @backend path /api/v1/* /api/browser/* /healthz /readyz /docs /docs/* /openapi.json /redoc
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
    header Strict-Transport-Security "max-age=86400"
}
