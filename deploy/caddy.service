[Unit]
Description=Caddy HTTPS for Forte
After=network-online.target
[Service]
User=@SERVICE_USER@
Environment=XDG_DATA_HOME=/var/lib/forte-caddy
Environment=XDG_CONFIG_HOME=/var/lib/forte-caddy
StateDirectory=forte-caddy
ExecStart=/usr/local/bin/caddy run --config @SERVICE_ROOT@/data/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
