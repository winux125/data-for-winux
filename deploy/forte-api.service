[Unit]
Description=Forte video audit HTTP API
After=network-online.target
[Service]
User=@SERVICE_USER@
WorkingDirectory=@SERVICE_ROOT@
EnvironmentFile=@SERVICE_ROOT@/secrets/service.env
ExecStart=@SERVICE_ROOT@/.venv/bin/uvicorn backend.api:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
